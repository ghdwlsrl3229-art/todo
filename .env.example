# Copy this file to .env and fill in real values. Never commit .env with
# real secrets -- it is already gitignored.

# MongoDB connection string (e.g. a MongoDB Atlas cluster). The app reads
# this as MONGODB_URI and uses it directly when present; otherwise it falls
# back to a local, ephemeral mongodb-memory-server instance for dev.
MONGODB_URI="mongodb://<user>:<password>@<host>/<database>?retryWrites=true&w=majority"

# GitHub OAuth App credentials. See docs/GITHUB_OAUTH_SETUP.md for how to
# create one. GITHUB_CLIENT_SECRET must never be hardcoded anywhere in the
# codebase -- it is only ever read from this environment variable.
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"
