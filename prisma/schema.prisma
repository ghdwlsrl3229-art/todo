generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Status {
  TODO
  DOING
  DONE
}

enum PeriodType {
  DAILY
  WEEKLY
  YEARLY
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  githubId  String    @unique
  username  String
  avatarUrl String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  todos     Todo[]
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Todo {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  status      Status     @default(TODO)
  periodType  PeriodType
  targetDate  DateTime
  order       Int        @default(0)
  parentId    String?    @db.ObjectId
  parent      Todo?      @relation("TodoHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Todo[]     @relation("TodoHierarchy")
  completedAt DateTime?
  userId      String     @db.ObjectId
  owner       User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([periodType, targetDate])
  @@index([status])
  @@index([parentId])
  @@index([userId])
}
